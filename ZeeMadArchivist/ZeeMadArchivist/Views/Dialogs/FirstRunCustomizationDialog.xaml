<ContentDialog
    x:Name="MainContent"
    x:Class="CyberFeedForward.TheMadArchivist.Views.Dialogs.FirstRunCustomizationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CyberFeedForward.TheMadArchivist.Converters"
    mc:Ignorable="d"
    PrimaryButtonText="OK"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
    </ContentDialog.Resources>

    <StackPanel x:Name="FirstRunCustomizationPanel" Spacing="16" DataContext="{Binding ViewModel, ElementName=MainContent}">
        <TextBlock
            Visibility="Collapsed"
            x:Name="FirstRunCustomizationDescriptionText"
            Text="Choose a few preferences before you start. You can change these later in Settings."
            TextWrapping="Wrap" />

        <Border BorderThickness="1" BorderBrush="Black" Padding="10">
            <StackPanel x:Name="ArchiveSelectPanel" >
                <Grid x:Name="InitialArchivePathSelectionGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="InitialArchivePathTextBox"
                        Header="Initial Archive"
                        PlaceholderText="C:\\Archives"
                        Text="{Binding InitialArchivePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        x:Name="BrowseInitialArchivePathButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="BrowseInitialArchivePathButton_OnClick"
                    >
                        <SymbolIcon Symbol="NewFolder" />
                    </Button>
                </Grid>

                <Grid x:Name="dd" ColumnSpacing="8" Margin="0,10,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        x:Name="ArchiveNameTextBox"
                        Header="Name"
                        PlaceholderText="MyArchive"
                        Text="{Binding ArchiveName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        Grid.Column="1"
                        x:Name="DriveLetterComboBox"
                        Header="Drive letter"
                        ItemsSource="{Binding AvailableDriveLetters}"
                        SelectedItem="{Binding SelectedDriveLetter, Mode=TwoWay}" />

                    <TextBlock Text="Icon" Grid.Column="3" />

                    <Button
                        x:Name="BrowseInitialIconPathButton"
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Click="BrowseInitialIconPathButton_OnClick">

                        <Image
                        x:Name="InitialIconPreviewImage"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Bottom"
                        Stretch="Uniform"
                        Visibility="Collapsed" />

                        <!--<SymbolIcon Symbol="OpenFile" />-->
                    </Button>

                    <TextBox
                        Visibility="Collapsed"
                        Grid.Column="4"
                        x:Name="InitialIconPathTextBox"
                        Header="Drive icon"
                        PlaceholderText="AppIcon.ico"
                        Text="{Binding SelectedIconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border BorderThickness="1" BorderBrush="Black" Padding="10" >
            <StackPanel>

                <Grid x:Name="InitialCustomIconsPathSelectionGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="InitialCustomIconsPathTextBox"
                        Header="Initial custom icons path"
                        PlaceholderText="C:\\Archives\\CustomIcons"
                        Text="{Binding InitialCustomIconsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        x:Name="BrowseInitialCustomIconsPathButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="BrowseInitialCustomIconsPathButton_OnClick"
                        >
                        <SymbolIcon Symbol="NewFolder" />
                    </Button>
                </Grid>

                <ComboBox
                    Margin="0,10,0,0"
                    x:Name="ThemeModeComboBox"
                    Header="Theme"
                    SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Name="ThemeModeSystemDefaultItem" Content="System default" />
                    <ComboBoxItem x:Name="ThemeModeLightItem" Content="Light" />
                    <ComboBoxItem x:Name="ThemeModeDarkItem" Content="Dark" />
                </ComboBox>

                <ToggleSwitch
                        Margin="0,10,0,0"
                        Grid.Column="1"
                        x:Name="StartupToggleSwitch"
                        Header="Launch at startup"
                        OffContent="Do not launch when Windows starts"
                        OnContent="Launch when Windows starts"
                        IsOn="{Binding SetStartup, Mode=TwoWay}" />

                <ToggleSwitch
                    Visibility="Collapsed"
                    x:Name="CommandBarLocationToggleSwitch"
                    Header="Navigation layout"
                    OffContent="Command bar on the right"
                    OnContent="Command bar on the left"
                    IsOn="{Binding IsCommandBarOnLeft, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="ErrorTextBlock"
            Foreground="Red"
            TextWrapping="Wrap"
            Text="{Binding ErrorMessage}"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
    </StackPanel>
</ContentDialog>
