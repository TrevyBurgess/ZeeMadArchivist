<ContentDialog
    x:Class="CyberFeedForward.TheMadArchivist.Views.Dialogs.FirstRunCustomizationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Customize ZeeMadArchivist"
    PrimaryButtonText="Save"
    CloseButtonText="Skip"
    DefaultButton="Primary">

    <StackPanel x:Name="FirstRunCustomizationPanel" Spacing="16">
        <TextBlock
            x:Name="FirstRunCustomizationDescriptionText"
            Text="Choose a few preferences before you start. You can change these later in Settings."
            TextWrapping="Wrap" />

        <ComboBox
            x:Name="ThemeModeComboBox"
            Header="Theme"
            SelectedIndex="0">
            <ComboBoxItem x:Name="SystemThemeComboBoxItem" Content="Use system setting" />
            <ComboBoxItem x:Name="LightThemeComboBoxItem" Content="Light" />
            <ComboBoxItem x:Name="DarkThemeComboBoxItem" Content="Dark" />
        </ComboBox>

        <ToggleSwitch
            x:Name="CommandBarLocationToggleSwitch"
            Header="Navigation layout"
            OffContent="Command bar on the right"
            OnContent="Command bar on the left" />

        <ToggleSwitch
            x:Name="StartupToggleSwitch"
            Header="Launch at startup"
            OffContent="Do not launch when Windows starts"
            OnContent="Launch when Windows starts" />

        <TextBlock
            x:Name="ErrorTextBlock"
            Foreground="Red"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
