<ContentDialog
    x:Class="CyberFeedForward.TheMadArchivist.Views.Dialogs.NewArchiveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CyberFeedForward.TheMadArchivist.Converters"
    mc:Ignorable="d"
    Title="New Archive"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
    </ContentDialog.Resources>

    <Grid x:Name="NewArchiveDialogRootGrid" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="NewArchiveDialogFieldsPanel" Spacing="8">
            <Grid x:Name="FolderPathSelectionGrid" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="FolderPathTextBox"
                    Header="Folder path"
                    PlaceholderText="C:\\Archives"
                    Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay}" />

                <Button
                    x:Name="BrowseFolderButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="BrowseFolderButton_OnClick"
                    Content="Browse" />
            </Grid>

            <TextBox
                x:Name="ArchiveNameTextBox"
                Header="Archive name"
                PlaceholderText="MyArchive"
                Text="{x:Bind ViewModel.ArchiveName, Mode=TwoWay}" />

            <ComboBox
                x:Name="DriveLetterComboBox"
                Header="Drive letter"
                ItemsSource="{x:Bind ViewModel.AvailableDriveLetters}"
                SelectedItem="{x:Bind ViewModel.SelectedDriveLetter, Mode=TwoWay}" />

            <Grid x:Name="IconPathSelectionGrid" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="IconPathTextBox"
                    Header="Icon path"
                    PlaceholderText="AppIcon.ico"
                    Text="{x:Bind ViewModel.IconPath, Mode=TwoWay}" />

                <Button
                    x:Name="BrowseIconButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="BrowseIconButton_OnClick"
                    Content="Browse" />
            </Grid>
        </StackPanel>

        <TextBlock
            x:Name="ErrorTextBlock"
            Grid.Row="1"
            Foreground="Red"
            TextWrapping="Wrap"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}, Mode=OneWay}" />
    </Grid>
</ContentDialog>
